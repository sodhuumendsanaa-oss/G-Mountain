rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // User profile and private mountain data
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }
    // Public shared mountains (for viewing each other's mountains)
    match /shared_mountains/{userId} {
      allow read: if true;
      allow write: if request.auth != null && request.auth.uid == userId;
    }
  }
}
